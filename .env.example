# Terminal3 T3N Agent SDK configuration
# Set your sandbox API key (from https://go.terminal3.io/adk-community success screen)
T3N_API_KEY=your-sandbox-api-key-here
# The secure path (fetchTrustedManifest) can stall fetching the TDX attestation quote
# (~37KB) on some networks -> handshake "terminated".
# Set to 1 to use { unsafe_trust_server: true } (dev opt-out, skips attestation fetch; fine for sandbox test credits).
T3N_UNSAFE_TRUST=1